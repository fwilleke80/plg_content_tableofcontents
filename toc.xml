<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
    <name>PLG_CONTENT_TOC</name>
    <author>Frank Willeke</author>
    <version>1.0.8</version>
    <targetplatform name="joomla" version="5\.0|6\.0" />
    <creationDate>13. April 2026</creationDate>
    <copyright>(C) 2026 Frank Willeke</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorUrl>www.frankwilleke.com</authorUrl>
    <authorEmail>joomla-plugins@frankwilleke.de</authorEmail>
    <description>PLG_CONTENT_TOC_DESC</description>
    <folder>content</folder>
    <group>content</group>
    <files>
        <filename plugin="toc">toc.php</filename>
    </files>
    <languages>
        <language tag="en-GB">language/en-GB/en-GB.plg_content_toc.ini</language>
        <language tag="en-GB">language/en-GB/en-GB.plg_content_toc.sys.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.plg_content_toc.ini</language>
        <language tag="de-DE">language/de-DE/de-DE.plg_content_toc.sys.ini</language>
    </languages>
    <updateservers>
        <server type="extension" name="Table of Contents Updates">https://frankwilleke.de/joomla-extensions/plg_content_tableofcontents_update.xml</server>
    </updateservers>
</extension>
